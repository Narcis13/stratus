node_modules
dist

# Env / secrets
.env
.env.local
.env.*.local
!.env.example

# Local token store — created by src/server.ts after OAuth callback.
# Glob covers backups + the restore/export helpers (.tokens.json.bak.*,
# .tokens.export.json, .tokens.fresh.json) — these hold live credentials.
.tokens*.json
.tokens.json*

# Local SQLite database (and its WAL/SHM sidecars) — replaced Neon 2026-06-19
stratus.db
stratus.db-wal
stratus.db-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Hand-made DB snapshots (`sqlite3 .backup stratus.db.pre-deploy-…`) and their
# sidecars. The bare `stratus.db` rule above does NOT match these — one such
# backup was committed and pushed to the public repo before this rule existed.
stratus.db.backup*
*.db.backup*
*.db.pre-*

# OS / editor
.DS_Store
*.swp
.vscode
.idea

# Logs
*.log
